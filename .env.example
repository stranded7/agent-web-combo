# --- Search providers ---
# At least one of these. AnySearch works anonymously (lower rate limits).
TAVILY_API_KEY=
EXA_API_KEY=
ANYSEARCH_API_KEY=

# --- Cloudflare Browser Run / Kitesurf ---
CF_ACCOUNT_ID=
CF_API_TOKEN=
# Optional override instead of constructing from CF_ACCOUNT_ID/CF_API_TOKEN
# KITESURF_WS_ENDPOINT=wss://api.cloudflare.com/client/v4/accounts/<ACCOUNT_ID>/browser-run/devtools/browser?browser=kitesurf

# --- Optional agent-reach CLI ---
# AGENT_REACH_CMD=agent-reach
